 "vo": [
  {
   "t": 0.4,
   "text": "Giờ mình làm cùng bạn, tám bước, trên hệ thống thật.",
   "syllables": 11,
   "est_end": 4.8
  },
  {
   "t": 6.3,
   "text": "Đăng nhập bằng VNeID.",
   "syllables": 6,
   "est_end": 8.7
  },
  {
   "t": 9.0,
   "text": "Chọn Thành lập mới hộ kinh doanh.",
   "syllables": 7,
   "est_end": 11.8
  },
  {
   "t": 12.9,
   "text": "Ba dòng sát nhau, dễ bấm nhầm, nhìn kỹ rồi mới Tiếp theo.",
   "syllables": 13,
   "est_end": 18.1
  },
  {
   "t": 19.3,
   "text": "Cột Khối dữ liệu là tám phần của hồ sơ, đi lần lượt từ trên xuống.",
   "syllables": 16,
   "est_end": 25.7
  },
  {
   "t": 25.8,
   "text": "Ở Địa chỉ, ô tỉnh đang chọn sẵn Cần Thơ, nhớ đổi sang tỉnh của bạn.",
   "syllables": 16,
   "est_end": 32.2
  },
  {
   "t": 32.4,
   "text": "Không còn quận, huyện, chọn thẳng phường, xã mới.",
   "syllables": 9,
   "est_end": 36.0
  },
  {
   "t": 36.6,
   "text": "Lưu xong, dòng đó có dấu tích xanh.",
   "syllables": 8,
   "est_end": 39.8
  },
  {
   "t": 40.3,
   "text": "Hệ thống hỏi mã ngành trước.",
   "syllables": 6,
   "est_end": 42.7
  },
  {
   "t": 44.6,
   "text": "Gõ mã, bấm Chọn.",
   "syllables": 4,
   "est_end": 46.2
  },
  {
   "t": 47.6,
   "text": "Cẩn thận: ô vuông chỉ để chọn dòng. Ngành chính là nút tròn bên cạnh.",
   "syllables": 15,
   "est_end": 53.6
  },
  {
   "t": 54.2,
   "text": "Tích ô vuông, Cập nhật chính, hệ thống im lặng.",
   "syllables": 10,
   "est_end": 58.2
  },
  {
   "t": 60.2,
   "text": "Không nhớ mã? Chỉ có cây ngành theo nhóm, không tìm theo tên.",
   "syllables": 13,
   "est_end": 65.4
  },
  {
   "t": 66.3,
   "text": "Chữ Hộ kinh doanh đã có sẵn, bạn chỉ gõ phần tên riêng.",
   "syllables": 13,
   "est_end": 71.5
  },
  {
   "t": 71.8,
   "text": "Gõ xong, bấm Kiểm tra trùng tên.",
   "syllables": 7,
   "est_end": 74.6
  },
  {
   "t": 75.2,
   "text": "Không trùng là đặt được.",
   "syllables": 5,
   "est_end": 77.2
  },
  {
   "t": 78.3,
   "text": "Chủ hộ là bạn thì chọn Cá nhân.",
   "syllables": 8,
   "est_end": 81.5
  },
  {
   "t": 81.6,
   "text": "Bấm Sao chép, rồi Đối chiếu với cơ sở dữ liệu dân cư.",
   "syllables": 13,
   "est_end": 86.8
  },
  {
   "t": 87.0,
   "text": "Thấy dòng Khớp là đúng.",
   "syllables": 5,
   "est_end": 89.0
  },
  {
   "t": 89.3,
   "text": "Ô tỉnh nơi ở lại chọn sẵn Cần Thơ, nhớ đổi lần nữa.",
   "syllables": 13,
   "est_end": 94.5
  },
  {
   "t": 97.0,
   "text": "Rồi bấm Lưu.",
   "syllables": 3,
   "est_end": 98.2
  },
  {
   "t": 100.3,
   "text": "Vốn chỉ cần gõ số.",
   "syllables": 5,
   "est_end": 102.3
  },
  {
   "t": 104.2,
   "text": "Đọc lại dòng Bằng chữ để chắc không thừa, thiếu số không.",
   "syllables": 12,
   "est_end": 109.0
  },
  {
   "t": 109.6,
   "text": "Thuế đang chọn sẵn Địa chỉ khác. Nhận thông báo ở chỗ kinh doanh thì chọn Giống trụ sở chính.",
   "syllables": 20,
   "est_end": 117.6
  },
  {
   "t": 118.5,
   "text": "Thuế khoán đã bỏ, chỉ còn kê khai.",
   "syllables": 8,
   "est_end": 121.7
  },
  {
   "t": 122.3,
   "text": "Đến người nộp hồ sơ.",
   "syllables": 5,
   "est_end": 124.3
  },
  {
   "t": 126.1,
   "text": "Tự nộp cho mình thì chọn Người có thẩm quyền ký Giấy đề nghị. Chỉ chọn ủy quyền khi nhờ người khác nộp hộ.",
   "syllables": 24,
   "est_end": 135.7
  },
  {
   "t": 135.9,
   "text": "Sao chép, đối chiếu, điền nơi ở, rồi Lưu.",
   "syllables": 9,
   "est_end": 139.5
  },
  {
   "t": 143.2,
   "text": "Đủ tám dấu tích, bấm Chuẩn bị.",
   "syllables": 7,
   "est_end": 146.0
  },
  {
   "t": 148.4,
   "text": "Hệ thống vẫn báo: phải chọn một ngành nghề kinh doanh chính. Đúng chỗ ô vuông lúc nãy.",
   "syllables": 18,
   "est_end": 155.6
  },
  {
   "t": 156.2,
   "text": "Chọn nút tròn, Cập nhật chính, Chuẩn bị lại.",
   "syllables": 9,
   "est_end": 159.8
  },
  {
   "t": 160.3,
   "text": "Hết lỗi mới tới trang xác nhận. Bấm Nộp là hồ sơ đi thật.",
